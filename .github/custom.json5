{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "major": {
    "enabled": true,
    "automerge": false,
    "dependencyDashboardApproval": false
  },
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "packageRules": [
    {
      "description": ["Talos 1.13 supports Kubernetes up to 1.36, and the GTX 960 keeps Talos on 1.13 (NVIDIA 580 is its last driver): never propose newer"],
      "matchPackageNames": ["ghcr.io/siderolabs/kubelet", "registry.k8s.io/kubectl"],
      "allowedVersions": "<1.37.0"
    },
    {
      "description": ["Talos stays on 1.13 for the GTX 960 (NVIDIA 580 is its last driver branch)"],
      "matchPackageNames": ["ghcr.io/siderolabs/installer", "ghcr.io/siderolabs/talosctl"],
      "allowedVersions": "<1.14.0"
    },
    {
      "description": ["CLI tools in mise.toml that must match the cluster versions: patch updates only (bump minors together with the Talos/Kubernetes/Flux upgrade)"],
      "matchManagers": ["mise"],
      "matchDepNames": ["talosctl", "kubectl", "flux2"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "description": ["Chart updates are reviewed by hand: newer TrueCharts charts can switch apps to root or to user namespaces, which break on Talos + NFS"],
      "matchManagers": ["flux"],
      "automerge": false
    },
    {
      "description": ["Release tags look like 2026.09.28.1 (4 parts); the default versioning can't compare them"],
      "matchPackageNames": ["Homebrew/actions"],
      "versioning": "loose"
    },
    {
      "description": ["Dev container only; oci.trueforge.org doesn't answer anonymous digest lookups"],
      "matchFileNames": [".devcontainer/**"],
      "enabled": false
    },
    {
      "description": ["Block automerge for Kubelet and Talos version Major"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": false,
      "matchPackageNames": ["ghcr.io/siderolabs/kubelet", "ghcr.io/siderolabs/installer"],
      "labels": ["type/major", "system-upgrade"]
    },
    {
      "description": ["Talos and Kubernetes must be upgraded one minor version at a time: one PR per minor, never automerged"],
      "matchPackageNames": ["ghcr.io/siderolabs/kubelet", "ghcr.io/siderolabs/installer"],
      "separateMultipleMinor": true,
      "automerge": false
    }
  ],
  "helm-values": {
    "managerFilePatterns": [
      "/(^|/)clusters/.+\\.ya?ml$/",
      "/(^|/)kubernetes/.+\\-values\\.ya?ml$/",
      "/(^|/)repositories/.+\\-values\\.ya?ml$/",
      "/(^|/)charts/.+\\-values\\.ya?ml$/"
    ]
  }
}
